NEXT_PUBLIC_BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
NEXT_PUBLIC_CONTRACT_ADDRESS=0x5bEd1F9d23FaFdE1A4b81215a2888812494d4107
NEXT_PUBLIC_DEPLOYMENT_BLOCK=140503064

# Shows the footer state line (chain / supply / blocker) on the mint page.
# Leave unset — or false — for any public build; the Pages build does not set it.
NEXT_PUBLIC_DEBUG=false

# Read API. Unset means the pages scan logs themselves, which is the current default.
# Set it to a running indexer (for example http://127.0.0.1:8081) to serve them from the index.
NEXT_PUBLIC_INDEXER_URL=

NEXT_PUBLIC_MARKET_ADDRESS=0x153bbf8fc8eD31ab8e73d9b5AE3076d73d3424e2
NEXT_PUBLIC_MARKET_DEPLOYMENT_BLOCK=140688854
# Indicative only; testnet tBNB has no value. Used for the "about one dollar" price hint.
NEXT_PUBLIC_BNB_USD_RATE=650
